# ═══════════════════════════════════════════════════════════════
# TicketBot — Environment Variables
#
# Каждая платформа использует свой .env файл:
#   .env.telegram  → Telegram бот
#   .env.vk        → VK бот
#   .env.max       → MAX бот
#
# Единая БД ticketbot, но каждая платформа подключается под
# своей PostgreSQL-ролью (tg_user, vk_user, max_user).
# ═══════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# 📦 Общая БД — строка подключения для миграций и seed
#    (под ролью postgres/admin)
# ────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ticketbot

# ────────────────────────────────────────────────────────────────
# 🤖 Telegram Bot (.env.telegram)
# ────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://tg_user:password@localhost:5432/ticketbot
# TELEGRAM_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHANNEL_ID=@your_channel_username
# ADMIN_TELEGRAM_IDS=123456,789012

# ────────────────────────────────────────────────────────────────
# 💬 VK Bot + VK Mini App (.env.vk)
# ────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://vk_user:password@localhost:5432/ticketbot
# VK_TOKEN=your_vk_group_token_here
# VK_GROUP_ID=your_vk_group_id_here
# VK_APP_ID=54698875                    # App ID VK Mini App (проверка sign launch params)
# VK_SECRET_KEY=your_vk_app_secret_key  # Секретный ключ VK приложения (подпись launch params)
# VK_TOKEN_ENCRYPTION_KEY=...           # Fernet-ключ для шифрования community token VK-групп
#                                       #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ────────────────────────────────────────────────────────────────
# 📱 MAX Bot (.env.max)
# ────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://max_user:password@localhost:5432/ticketbot
# MAX_TOKEN=your_max_bot_token_here

# ────────────────────────────────────────────────────────────────
# ⚙️ Общие настройки
# ────────────────────────────────────────────────────────────────
# DEBUG=false
