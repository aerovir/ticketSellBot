# VK Bot — подключение к БД под ролью vk_user
DATABASE_URL=postgresql+asyncpg://vk_user:vk_password_here@localhost:5432/ticketbot

# VK Community Token
VK_TOKEN=your_vk_group_token_here

# VK Group ID
VK_GROUP_ID=your_vk_group_id_here

# VK Mini App ID (реальный — в GitHub secrets VK_APP_ID)
VK_APP_ID=your_vk_app_id_here

# App
DEBUG=false
