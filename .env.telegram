# Telegram Bot — подключение к БД под ролью tg_user
DATABASE_URL=postgresql+asyncpg://tg_user:tg_password_here@localhost:5432/ticketbot

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Telegram канал для анонсов (@username или числовой ID)
TELEGRAM_CHANNEL_ID=@your_channel_username

# Telegram ID администраторов через запятую
ADMIN_TELEGRAM_IDS=123456,789012

# App
DEBUG=false

# URL веб-приложения (CORS для Telegram/VK Mini App)
WEBAPP_URL=https://pochtibot.online

# VK Mini App — валидация подписи launch params (web-контейнер)
VK_APP_ID=your_vk_app_id_here
VK_SECRET_KEY=your_vk_app_secret_key_here
