# SSH-конфигурация для подключения к продакшен-серверу
#
# Используется Makefile-целями logs-app, logs-raw, logs-health, logs-monitor.
# При смене хостинга или IP достаточно изменить SSH_HOST здесь.
#
# Копировать: cp deploy/.env.ssh.example .env.ssh
# (файл .env.ssh в .gitignore, не коммитится)

# SSH-хост (алиас из ~/.ssh/config или user@ip)
SSH_HOST=vps

# Путь к проекту на удалённом сервере
PROJ_DIR=/home/user/actions-runner/_work/ticketSellBot/ticketSellBot

# Docker Compose файлы для логирования
COMPOSE_FILES=-f docker-compose.yml -f deploy/docker-compose.beget.yml -f deploy/docker-compose.monitoring.yml
