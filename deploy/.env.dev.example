# Dev-окружение TicketBot (копировать в .env.dev на VDS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db-dev:5432/ticketbot_dev

# Dev-токен бота — отдельный от прода (создать через @BotFather /newbot)
TELEGRAM_TOKEN=

# Супер-админы (для dev — ID пользователя)
ADMIN_TELEGRAM_IDS=

# App
DEBUG=true
WEBAPP_URL=
