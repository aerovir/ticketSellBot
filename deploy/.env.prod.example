# Production environment для TicketBot
# DATABASE_URL указывает на сервис db внутри Docker-сети (не localhost!)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ticketbot

# Telegram Bot Token (получить у @BotFather)
TELEGRAM_TOKEN=

# VK Community Token
VK_TOKEN=
VK_GROUP_ID=

# MAX Bot Token (@MasterBot)
MAX_TOKEN=

# Production — debug выключен
DEBUG=false
