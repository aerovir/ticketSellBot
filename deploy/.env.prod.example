# Production environment для TicketBot
# Каждая платформа использует свой .env файл.
# Этот файл — пример для ручной настройки.

# ─── Telegram (.env.telegram) ─────────────────────────────
# DATABASE_URL=postgresql+asyncpg://tg_user:password@db:5432/ticketbot
# TELEGRAM_TOKEN=
# TELEGRAM_CHANNEL_ID=
# ADMIN_TELEGRAM_IDS=
# DEBUG=false

# ─── VK (.env.vk) ─────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://vk_user:password@db:5432/ticketbot
# VK_TOKEN=
# VK_GROUP_ID=
# DEBUG=false

# ─── MAX (.env.max) ───────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://max_user:password@db:5432/ticketbot
# MAX_TOKEN=
# DEBUG=false
